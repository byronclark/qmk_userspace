#!/usr/bin/env python3
"""Render the byron keymap as a printable PDF reference card.

Layers come from users/byron/byron.c, are placed on the keyboard's physical
layout through its LAYOUT_byron adapter and `qmk info`, and are printed to PDF
with headless Chrome. Nothing about the keymap is hard-coded here, so the PDF
tracks the firmware: edit the keymap, rerun, done.

    bin/keymap-pdf kyria                 # -> docs/keymap-kyria.pdf
    bin/keymap-pdf ergodox -o card.pdf
    bin/keymap-pdf all
    bin/keymap-pdf kyria --html out.html # also keep the HTML for previewing

Needs the qmk CLI and Google Chrome or Chromium (override with $CHROME).
"""

import argparse
import datetime
import html
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

