# ------------------------------------------------------------------ output --


def find_chrome():
    if os.environ.get("CHROME"):
        return os.environ["CHROME"]
    for name in ("google-chrome", "google-chrome-stable", "chromium", "chromium-browser"):
        if path := shutil.which(name):
            return path
    mac = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    if os.path.exists(mac):
        return mac
    sys.exit("Chrome or Chromium not found; set $CHROME to its path")


def print_pdf(html_text, out, keep_html=None):
    with tempfile.TemporaryDirectory() as tmp:
        src = Path(tmp) / "keymap.html"
        src.write_text(html_text)
        if keep_html:
            Path(keep_html).write_text(html_text)
        out.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [find_chrome(), "--headless", "--disable-gpu", "--no-pdf-header-footer",
             f"--user-data-dir={tmp}/profile", f"--print-to-pdf={out.resolve()}", src.as_uri()],
            check=True, capture_output=True,
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("keyboard", choices=[*KEYBOARDS, "all"])
    parser.add_argument("-o", "--output", type=Path, help="PDF path (default docs/keymap-<keyboard>.pdf)")
    parser.add_argument("--html", help="also write the intermediate HTML here")
    args = parser.parse_args()

    names = list(KEYBOARDS) if args.keyboard == "all" else [args.keyboard]
    if (args.output or args.html) and len(names) > 1:
        parser.error("--output and --html only work with a single keyboard")
    for name in names:
        out = args.output or ROOT / "docs" / f"keymap-{name}.pdf"
        print_pdf(render_html(name), out, args.html)
        print(f"wrote {out.relative_to(ROOT) if out.is_relative_to(ROOT) else out}")


if __name__ == "__main__":
    main()
