# ---------------------------------------------------------------- parsing --


def strip_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return re.sub(r"//[^\n]*", "", text)


def call_args(text, start):
    """Split the parenthesised argument list opening at text[start] on top-level commas."""
    assert text[start] == "("
    depth, args, cur = 0, [], ""
    for i in range(start, len(text)):
        ch = text[i]
        if ch == "(":
            depth += 1
            if depth == 1:
                continue
        elif ch == ")":
            depth -= 1
            if depth == 0:
                args.append(cur.strip())
                return [a for a in args if a], i
        elif ch == "," and depth == 1:
            args.append(cur.strip())
            cur = ""
            continue
        cur += ch
    raise ValueError("unbalanced parentheses")


def parse_header(path):
    text = strip_comments(path.read_text())
    enum = re.search(r"enum\s+\w*\s*\{(.*?)\}", text, re.S)
    layers = [n.split("=")[0].strip() for n in enum.group(1).split(",") if n.strip()]
    aliases = dict(re.findall(r"^\s*#define\s+(\w+)\s+(.+?)\s*$", text, re.M))
    return layers, aliases


def parse_layers(path):
    text = strip_comments(path.read_text())
    layers = {}
    for m in re.finditer(r"\[\s*(\w+)\s*\]\s*=\s*LAYOUT_byron\s*\(", text):
        args, _ = call_args(text, m.end() - 1)
        layers[m.group(1)] = args
    return layers


def parse_adapter(path):
    """Return (native layout macro, {LAYOUT_byron param -> native key index})."""
    text = strip_comments(path.read_text()).replace("\\\n", " ")
    m = re.search(r"#define\s+LAYOUT_byron\s*\(", text)
    params, end = call_args(text, m.end() - 1)
    body = re.compile(r"\s*(\w+)\s*\(").match(text, end + 1)
    native, _ = call_args(text, body.end() - 1)
    index = {name: i for i, name in enumerate(native) if name in params}
    return body.group(1), params, index, len(native)


def parse_config(path):
    text = strip_comments(path.read_text())
    defines = {}
    for name, value in re.findall(r"^\s*#define\s+(\w+)[ \t]*(.*?)\s*$", text, re.M):
        defines[name] = value
    return defines


def qmk_layout(keyboard, macro):
    out = subprocess.run(
        ["qmk", "info", "-kb", keyboard, "-l", "-f", "json"],
        check=True, capture_output=True, text=True,
    ).stdout
    info = json.loads(out[out.index("{"):])
    macro = info.get("layout_aliases", {}).get(macro, macro)
    return info["layouts"][macro]["layout"]


def git_stamp():
    try:
        rev = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"],
                             check=True, capture_output=True, text=True).stdout.strip()
        dirty = subprocess.run(["git", "-C", ROOT, "status", "--porcelain", "users", "keyboards"],
                               check=True, capture_output=True, text=True).stdout.strip()
        return rev + ("+dirty" if dirty else "")
    except (OSError, subprocess.CalledProcessError):
        return "unknown"


# ------------------------------------------------------------------ model --


@dataclass
class Key:
    kind: str  # key | mod | trans | none
    code: str = ""
    primary: str = ""
    secondary: str | None = None
    icon: str | None = None
    hold_mod: str | None = None
    hold_layer: str | None = None
    shifted_from: str | None = None


def resolve(code, aliases):
    seen = set()
    while code in aliases and code not in seen:
        seen.add(code)
        code = aliases[code]
    return code


def decode(code, aliases):
    code = resolve(code, aliases)
    if code in ("_______", "KC_TRNS", "KC_TRANSPARENT"):
        return Key("trans", code)
    if code in ("XXXXXXX", "KC_NO", "XXX"):
        return Key("none", code)
    if m := re.fullmatch(r"LT\(\s*(\w+)\s*,\s*(\w+)\s*\)", code):
        key = decode(m.group(2), aliases)
        key.hold_layer = m.group(1)
        return key
    if m := re.fullmatch(r"[LR](GUI|ALT|CTL|SFT)_T\(\s*(\w+)\s*\)", code):
        key = decode(m.group(2), aliases)
        key.hold_mod = m.group(1)
        return key
    if m := re.fullmatch(r"(MO|TG|TO|OSL|TT|DF)\(\s*(\w+)\s*\)", code):
        return Key("key", code, layer_name(m.group(2)), m.group(1))
    if code in MOD_KEYCODES:
        glyph, word = MODS[MOD_KEYCODES[code]]
        return Key("mod", code, glyph, word)
    if code in LEGENDS:
        primary, secondary, icon = LEGENDS[code]
        return Key("key", code, primary, secondary, icon)
    if m := re.fullmatch(r"KC_(F\d+|[A-Z0-9])", code):
        return Key("key", code, m.group(1))
    return Key("key", code, code.removeprefix("KC_"))


def layer_name(enum):
    return enum.lstrip("_")


@dataclass
class Layer:
    enum: str
    keys: list
    color: str
    activator: int | None = None  # index into the 40-slot grid of the key held to reach it
    shift_of: str | None = None

    @property
    def name(self):
        return layer_name(self.enum)


def hand(slot):
    return "left" if slot % 10 < 5 else "right"


def load_keymap():
    enums, aliases = parse_header(USER / "byron.h")
    raw = parse_layers(USER / "byron.c")
    spare = iter(FALLBACK_COLORS)
    layers = []
    for enum in enums:
        if enum not in raw:
            continue
        codes = raw[enum]
        if len(codes) != 40:
            sys.exit(f"{enum}: expected 40 keys in LAYOUT_byron, found {len(codes)}")
        color = LAYER_COLORS.get(layer_name(enum)) or next(spare, "#777777")
        layers.append(Layer(enum, [decode(c, aliases) for c in codes], color))

    base = layers[0]
    by_enum = {layer.enum: layer for layer in layers}
    for slot, key in enumerate(base.keys):
        if key.hold_layer in by_enum and by_enum[key.hold_layer].activator is None:
            by_enum[key.hold_layer].activator = slot

    find_shift_pairs(layers)
    return layers


def find_shift_pairs(layers):
    """Mark layers whose symbols are mostly the shifted keys of another layer."""
    for upper in layers[1:]:
        for lower in layers[1:]:
            if upper is lower:
                continue
            pairs = [(u, l) for u, l in zip(upper.keys, lower.keys)
                     if u.kind == "key" and l.kind == "key"]
            hits = [(u, l) for u, l in pairs if US_SHIFT.get(l.primary) == u.primary]
            if len(pairs) >= 8 and len(hits) >= 0.75 * len(pairs):
                upper.shift_of = lower.name
                for u, l in hits:
                    u.shifted_from = l.primary
                break


# --------------------------------------------------------------- geometry --

U = 64.0  # SVG units per key unit


@dataclass
class Cap:
    x: float
    y: float
    w: float
    h: float
    r: float = 0.0
    rx: float = 0.0
    ry: float = 0.0
    slot: int | None = None  # index into the 40-slot LAYOUT_byron grid, None if unused

    def corners(self):
        pts = [(self.x, self.y), (self.x + self.w, self.y),
               (self.x, self.y + self.h), (self.x + self.w, self.y + self.h)]
        if not self.r:
            return pts
        a = math.radians(self.r)
        return [(self.rx + (px - self.rx) * math.cos(a) - (py - self.ry) * math.sin(a),
                 self.ry + (px - self.rx) * math.sin(a) + (py - self.ry) * math.cos(a))
                for px, py in pts]


def load_board(name):
    keyboard, adapter, title = KEYBOARDS[name]
    macro, params, index, count = parse_adapter(ROOT / adapter / "config.h")
    geometry = qmk_layout(keyboard, macro)
    if len(geometry) != count:
        sys.exit(f"{macro}: adapter passes {count} keys but QMK describes {len(geometry)}")
    slot_of = {index[p]: slot for slot, p in enumerate(params) if p in index}
    caps = [Cap(g["x"], g["y"], g.get("w", 1), g.get("h", 1),
                g.get("r", 0), g.get("rx", 0), g.get("ry", 0), slot_of.get(i))
            for i, g in enumerate(geometry)]
    return title, caps


# -------------------------------------------------------------- rendering --


def mix(color, other, amount):
    """Blend `amount` of `other` into `color`."""
    a = [int(color[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(other[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * amount):02x}" for x, y in zip(a, b))


INK = "#23252e"
SLATE = "#62667a"
PAPER = "#fbfaf7"
WHITE = "#ffffff"
BLACK = "#000000"


def esc(text):
    return html.escape(text, quote=True)


def text_el(x, y, s, size, fill, weight=600, family="var(--keys)", anchor="middle", extra=""):
    return (f'<text x="{x:.1f}" y="{y:.1f}" font-size="{size:.1f}" fill="{fill}" '
            f'font-weight="{weight}" font-family="{family}" text-anchor="{anchor}" '
            f'dominant-baseline="central"{extra}>{esc(s)}</text>')


def primary_size(s):
    if len(s) <= 1:
        return 0.40 * U
    if len(s) <= 3:
        return 0.27 * U
    return 0.21 * U


def icon_el(name, cx, cy, size, color):
    s = size / 24
    return (f'<g transform="translate({cx - size / 2:.1f} {cy - size / 2:.1f}) scale({s:.3f})" '
            f'color="{color}">{ICONS[name]}</g>')


def legend(key, cx, top, bottom, ink, sub_ink):
    """Stack a key's legend between `top` and `bottom` of its face."""
    out = []
    has_sub = bool(key.secondary)
    mid = (top + bottom) / 2
    main_y = mid - (0.11 * U if has_sub else 0)
    if key.icon:
        out.append(icon_el(key.icon, cx, main_y, 0.36 * U, ink))
    elif key.primary:
        out.append(text_el(cx, main_y, key.primary, primary_size(key.primary), ink))
    if has_sub:
        out.append(text_el(cx, mid + 0.22 * U, key.secondary, 0.165 * U, sub_ink, weight=600))
    return out


def draw_cap(cap, style, body):
    """One keycap: skirt, top face and whatever `body(cx, top, bottom)` draws on it."""
    pad = 0.05 * U
    x, y = cap.x * U + pad, cap.y * U + pad
    w, h = cap.w * U - 2 * pad, cap.h * U - 2 * pad
    out = [f'<g transform="rotate({cap.r} {cap.rx * U:.1f} {cap.ry * U:.1f})">' if cap.r else "<g>"]
    if style.get("dashed"):
        out.append(f'<rect x="{x:.1f}" y="{y:.1f}" width="{w:.1f}" height="{h:.1f}" rx="{0.13 * U:.1f}" '
                   f'fill="none" stroke="{style["stroke"]}" stroke-width="1.1" stroke-dasharray="3 3"/>')
        out.append("</g>")
        return out
    out.append(f'<rect x="{x:.1f}" y="{y:.1f}" width="{w:.1f}" height="{h:.1f}" rx="{0.13 * U:.1f}" '
               f'fill="{style["skirt"]}" stroke="{style["stroke"]}" stroke-width="0.9"/>')
    fx, fy = x + 0.07 * U, y + 0.04 * U
    fw, fh = w - 0.14 * U, h - 0.15 * U
    out.append(f'<rect x="{fx:.1f}" y="{fy:.1f}" width="{fw:.1f}" height="{fh:.1f}" rx="{0.1 * U:.1f}" '
               f'fill="{style["top"]}"/>')
    out += body(fx + fw / 2, fy, fy + fh, fx, fx + fw)
    out.append("</g>")
    return out


STYLE_PHANTOM = {"dashed": True, "stroke": "#dcd8cf"}
STYLE_EMPTY = {"skirt": "#ecebe6", "top": "#f5f4f0", "stroke": "#e2e0d9"}
STYLE_PLAIN = {"skirt": "#e3e0d8", "top": WHITE, "stroke": "#cfcbc1"}
STYLE_MOD = {"skirt": "#d9d7d1", "top": "#efeeea", "stroke": "#c9c6be"}


def tinted(color):
    return {"skirt": mix(color, WHITE, 0.55), "top": mix(color, WHITE, 0.87), "stroke": mix(color, WHITE, 0.35)}


def solid(color):
    return {"skirt": mix(color, BLACK, 0.25), "top": color, "stroke": mix(color, BLACK, 0.35)}


def board_svg(caps, draw, island=None, island_color=None, css_class="board"):
    """Render every physical key with `draw(cap) -> svg strings`."""
    pts = [p for cap in caps for p in cap.corners()]
    m = 0.2
    x0, y0 = min(p[0] for p in pts) - m, min(p[1] for p in pts) - m
    x1, y1 = max(p[0] for p in pts) + m, max(p[1] for p in pts) + m
    out = [f'<svg class="{css_class}" viewBox="{x0 * U:.1f} {y0 * U:.1f} {(x1 - x0) * U:.1f} {(y1 - y0) * U:.1f}" '
           f'xmlns="http://www.w3.org/2000/svg">']
    if island:
        # Opaque shapes inside a translucent group so overlaps merge into one soft region.
        out.append(f'<g opacity="0.13" fill="{island_color}">')
        g = 0.16
        for cap in island:
            rot = f' transform="rotate({cap.r} {cap.rx * U:.1f} {cap.ry * U:.1f})"' if cap.r else ""
            out.append(f'<rect x="{(cap.x - g) * U:.1f}" y="{(cap.y - g) * U:.1f}" '
                       f'width="{(cap.w + 2 * g) * U:.1f}" height="{(cap.h + 2 * g) * U:.1f}" '
                       f'rx="{0.32 * U:.1f}"{rot}/>')
        out.append("</g>")
    for cap in caps:
        out += draw(cap)
    out.append("</svg>")
    return "\n".join(out)


def base_board(caps, base, layers_by_enum):
    def draw(cap):
        if cap.slot is None:
            return draw_cap(cap, STYLE_PHANTOM, None)
        key = base.keys[cap.slot]
        if key.kind == "none":
            return draw_cap(cap, STYLE_EMPTY, lambda *a: [])
        target = layers_by_enum.get(key.hold_layer)
        style = STYLE_PLAIN
        if target:
            style = {"skirt": mix(target.color, WHITE, 0.45), "top": mix(target.color, WHITE, 0.9),
                     "stroke": mix(target.color, WHITE, 0.25)}

        def body(cx, top, bottom, left, right):
            out = []
            if target:
                # Icon, word and chip stacked tight so they fit a 1u thumb key.
                chip_y = bottom - 0.14 * U
                word_y = chip_y - 0.2 * U
                main_y = (top + word_y) / 2 - 0.02 * U if key.secondary else (top + chip_y) / 2
                if key.icon:
                    out.append(icon_el(key.icon, cx, main_y, 0.28 * U, INK))
                elif key.primary:
                    out.append(text_el(cx, main_y, key.primary, primary_size(key.primary) * 0.8, INK))
                if key.secondary:
                    out.append(text_el(cx, word_y, key.secondary, 0.15 * U, SLATE, weight=600))
                out.append(chip(cx, chip_y, target.name, target.color))
            elif key.hold_mod:
                out += legend(key, cx, top, bottom - 0.18 * U, INK, SLATE)
                glyph, word = MODS[key.hold_mod]
                out.append(text_el(cx, bottom - 0.15 * U, f"{glyph} {word}", 0.155 * U, SLATE, weight=600))
            else:
                out += legend(key, cx, top, bottom, INK, SLATE)
            return out

        return draw_cap(cap, style, body)

    return board_svg(caps, draw)


def chip(cx, cy, label, color):
    w, h = (0.105 * len(label) + 0.16) * U, 0.2 * U
    return (f'<rect x="{cx - w / 2:.1f}" y="{cy - h / 2:.1f}" width="{w:.1f}" height="{h:.1f}" '
            f'rx="{h / 2:.1f}" fill="{color}"/>'
            + text_el(cx, cy + 0.5, label, 0.13 * U, WHITE, weight=700, extra=' letter-spacing="0.6"'))


def layer_board(caps, layer, base):
    color = layer.color
    content_ink = mix(color, BLACK, 0.55)
    content_sub = mix(color, BLACK, 0.3)

    def draw(cap):
        if cap.slot is None:
            return draw_cap(cap, STYLE_PHANTOM, None)
        key = layer.keys[cap.slot]
        if cap.slot == layer.activator:
            def held(cx, top, bottom, left, right):
                tap = base.keys[cap.slot]
                out = legend(Key("key", primary=tap.primary, icon=tap.icon), cx, top, bottom - 0.2 * U, WHITE, WHITE)
                out.append(text_el(cx, bottom - 0.16 * U, "HOLD", 0.13 * U, WHITE, weight=700,
                                   extra=' letter-spacing="1.2"'))
                return out
            return draw_cap(cap, solid(color), held)
        if key.kind == "none":
            return draw_cap(cap, STYLE_EMPTY, lambda *a: [])
        if key.kind == "trans":
            under = base.keys[cap.slot]

            def ghost(cx, top, bottom, left, right):
                return legend(Key("key", primary=under.primary, secondary=under.secondary, icon=under.icon),
                              cx, top, bottom, "#b9b6ad", "#c6c3bb")
            return draw_cap(cap, STYLE_EMPTY, ghost)
        if key.kind == "mod":
            return draw_cap(cap, STYLE_MOD, lambda cx, t, b, l, r: legend(key, cx, t, b, SLATE, SLATE))

        def content(cx, top, bottom, left, right):
            out = legend(key, cx, top, bottom, content_ink, content_sub)
            if key.shifted_from:
                out.append(text_el(right - 0.08 * U, top + 0.14 * U, key.shifted_from, 0.18 * U,
                                   mix(color, BLACK, 0.05), weight=600, anchor="end"))
            return out
        return draw_cap(cap, tinted(color), content)

    island = [cap for cap in caps if cap.slot is not None and layer.keys[cap.slot].kind == "key"
              and cap.slot != layer.activator]
    return board_svg(caps, draw, island, color)


def thumb_strip(layers, current):
    """Mini thumb keys, left to right, used as page tabs."""
    reachable = sorted((layer for layer in layers if layer.activator is not None), key=lambda l: l.activator)
    items = [layers[0]] + reachable
    cells = []
    x = 0.0
    for i, layer in enumerate(items):
        # Gap after BASE and between the left- and right-thumb groups.
        if i == 1 or (i > 1 and hand(layer.activator) != hand(items[i - 1].activator)):
            x += 0.35
        on = layer is current
        w = 1.25
        fill = layer.color if on else WHITE
        stroke = layer.color
        ink = WHITE if on else mix(layer.color, BLACK, 0.2)
        cells.append(f'<rect x="{x * U:.1f}" y="2" width="{w * U:.1f}" height="{0.5 * U:.1f}" '
                     f'rx="{0.25 * U:.1f}" fill="{fill}" stroke="{stroke}" stroke-width="2"/>')
        cells.append(text_el((x + w / 2) * U, 2 + 0.25 * U, layer.name, 0.24 * U, ink, weight=700,
                             extra=' letter-spacing="1.5"'))
        x += w + 0.12
    width = x * U
    return (f'<svg class="tabs" viewBox="-2 0 {width + 4:.1f} {0.5 * U + 4:.1f}" '
            f'xmlns="http://www.w3.org/2000/svg">' + "".join(cells) + "</svg>")


def activation(layer, base):
    key = base.keys[layer.activator]
    word = key.secondary or key.primary
    return f"Hold {word}", f"{hand(layer.activator)} thumb"


def join_words(words):
    return words[0] if len(words) == 1 else ", ".join(words[:-1]) + " and " + words[-1]


def layer_notes(layer, base):
    """Short observations derived from the keymap itself."""
    notes = []
    for side in ("left", "right"):
        mods = [k.primary for slot, k in enumerate(layer.keys) if k.kind == "mod" and hand(slot) == side]
        if mods:
            notes.append(f"Plain {' '.join(mods)} under the {side} hand, so they combine with anything here.")
    plain = [base.keys[slot].secondary or base.keys[slot].primary
             for slot, k in enumerate(layer.keys)
             if base.keys[slot].hold_layer and k.kind == "key" and not k.hold_layer
             and k.code == base.keys[slot].code]
    if plain:
        notes.append(f"{join_words(plain)} drop their layer holds here, so they auto-repeat.")
    if layer.shift_of:
        notes.append(f"Each symbol sits on its unshifted twin from {layer.shift_of.title()}, shown in the corner.")
    return notes


def tuning_line(config):
    bits = []
    if "TAPPING_TERM" in config:
        bits.append(f"{config['TAPPING_TERM']} ms tapping term")
    if "QUICK_TAP_TERM" in config:
        bits.append(f"{config['QUICK_TAP_TERM']} ms quick tap")
    for flag, label in [("CHORDAL_HOLD", "chordal hold"),
                        ("PERMISSIVE_HOLD", "permissive hold"),
                        ("PERMISSIVE_HOLD_PER_KEY", "permissive hold (per key)"),
                        ("HOLD_ON_OTHER_KEY_PRESS", "hold on other key press"),
                        ("SPECULATIVE_HOLD", "speculative hold")]:
        if flag in config:
            bits.append(label)
    return " · ".join(bits)


def swatch(style, label, text=""):
    if style.get("dashed"):
        box = (f'<rect x="1" y="1" width="20" height="20" rx="4" fill="none" stroke="{style["stroke"]}" '
               f'stroke-width="1.2" stroke-dasharray="3 2.5"/>')
    else:
        box = (f'<rect x="1" y="1" width="20" height="20" rx="4" fill="{style["skirt"]}" stroke="{style["stroke"]}"/>'
               f'<rect x="3" y="2" width="16" height="15" rx="3" fill="{style["top"]}"/>')
        if text:
            box += text_el(11, 9.5, text, 9, style.get("ink", INK), weight=700)
    return f'<span class="swatch"><svg viewBox="0 0 22 22">{box}</svg>{esc(label)}</span>'


def page_head(title, layers, current, page, total):
    return f"""
  <header class="masthead">
    <div class="eyebrow">{esc(title)}<span class="dot">·</span>{page} / {total}</div>
    {thumb_strip(layers, current)}
  </header>"""


def page_foot(stamp, extra=""):
    return f"""
  <footer>
    <div class="foot-left">{extra}</div>
    <div class="stamp">Generated from users/byron/byron.c @ {esc(stamp)}</div>
  </footer>"""


def render_html(board_name):
    board_title, caps = load_board(board_name)
    layers = load_keymap()
    config = parse_config(USER / "config.h")
    base = layers[0]
    by_enum = {layer.enum: layer for layer in layers}
    stamp = f"{git_stamp()} · {datetime.date.today().isoformat()}"
    ordered = sorted((l for l in layers[1:] if l.activator is not None), key=lambda l: l.activator)
    ordered += [l for l in layers[1:] if l.activator is None]
    total = 1 + len(ordered)
    header_title = f"byron · {board_title} · {sum(1 for k in base.keys if k.kind != 'none')} keys"

    pages = []

    cards = []
    for side in ("left", "right"):
        group = [l for l in ordered if l.activator is not None and hand(l.activator) == side]
        if not group:
            continue
        items = "".join(
            f"""<div class="card" style="--c:{l.color}">
                  <div class="card-name">{esc(l.name.title())}</div>
                  <div class="card-how">{esc(activation(l, base)[0])}</div>
                  <div class="card-what">{esc(LAYER_BLURBS.get(l.name, ""))}</div>
                </div>""" for l in group)
        cards.append(f'<div class="card-group"><div class="group-label">{side} thumb</div>'
                     f'<div class="cards">{items}</div></div>')

    pages.append(f"""
<section class="page" style="--c:{base.color}">
  {page_head(header_title, layers, base, 1, total)}
  <div class="title-row">
    <h1>{esc(base.name.title())}</h1>
    <p class="lede">{esc(LAYER_BLURBS.get(base.name, ""))}</p>
  </div>
  <div class="stage">{base_board(caps, base, by_enum)}</div>
  <div class="card-row">{"".join(cards)}</div>
  {page_foot(stamp, esc("Tap-hold: " + tuning_line(config)) if tuning_line(config) else "")}
</section>""")

    legend_row = "".join([
        swatch(solid("#888888") | {"ink": WHITE}, "held thumb"),
        swatch(tinted("#888888"), "this layer"),
        swatch(STYLE_MOD | {"ink": SLATE}, "modifier", "⇧"),
        swatch(STYLE_EMPTY | {"ink": "#b9b6ad"}, "falls through", "a"),
        swatch(STYLE_EMPTY, "no-op"),
        swatch(STYLE_PHANTOM, "unused key"),
    ])

    for n, layer in enumerate(ordered, start=2):
        how, where = activation(layer, base) if layer.activator is not None else ("", "")
        notes = layer_notes(layer, base)
        note = '<ul class="notes">' + "".join(f"<li>{esc(n)}</li>" for n in notes) + "</ul>" if notes else ""
        pages.append(f"""
<section class="page" style="--c:{layer.color}">
  {page_head(header_title, layers, layer, n, total)}
  <div class="title-row">
    <h1>{esc(layer.name.title())}</h1>
    <div class="how"><span class="how-key">{esc(how)}</span><span class="how-where">{esc(where)}</span></div>
    <p class="lede">{esc(LAYER_BLURBS.get(layer.name, ""))}</p>
    {note}
  </div>
  <div class="stage">{layer_board(caps, layer, base)}</div>
  {page_foot(stamp, f'<div class="swatches">{legend_row}</div>')}
</section>""")

    return f"""<!doctype html>
<html><head><meta charset="utf-8"><title>byron keymap · {esc(board_title)}</title>
<style>{CSS}</style></head>
<body>{"".join(pages)}</body></html>"""


CSS = f"""
